# UriGo staging — copiar para deploy/.env.staging
POSTGRES_USER=uritech
POSTGRES_PASSWORD=uritech_staging
POSTGRES_DB=uritech_staging
DATABASE_URL=postgresql://uritech:uritech_staging@postgres:5432/uritech_staging
