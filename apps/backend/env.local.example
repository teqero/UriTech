# UriTech Backend — Configuração de Desenvolvimento Local (sem Docker)
# Usa SQLite em vez de PostgreSQL e Redis mock em memória
# 
# Para usar: copie este ficheiro para .env na pasta apps/backend/
#   cp apps/backend/env.local.example apps/backend/.env

NODE_ENV=development
PORT=4000

# Database — SQLite para desenvolvimento local
DATABASE_URL=sqlite:./uritech-dev.db
TYPEORM_SYNC=true

# Redis — mock em memória (defina REDIS_URL=redis://localhost:6379 para Redis real)
REDIS_URL=memory:

# Auth
JWT_SECRET=dev-secret-key-change-in-production-min-32-chars
REQUIRE_VERIFIED_EMAIL=false
AUTO_LOGIN_AFTER_REGISTER=true

# Email — em dev, emails sao logados em vez de enviados
# Descomente e configure para enviar emails reais:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@uritech.com
# SMTP_PASS=app-password
PUBLIC_APP_URL=http://localhost:3001

# Storage — MinIO local (se estiver a correr)
# Se MinIO nao estiver disponivel, uploads falham graceful
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=uritech-media
S3_ACCESS_KEY=uritech
S3_SECRET_KEY=uritech123

# Push Notifications — desativado em dev
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@uritech.com

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Pagamentos — sandbox
MULTICAIXA_ENV=sandbox
PUBLIC_API_URL=http://localhost:4000
