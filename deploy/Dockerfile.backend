# NestJS API — staging/prod
# bookworm (glibc) evita falhas de native build do better-sqlite3 no Alpine/musl.
FROM node:20-bookworm-slim AS builder
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json* ./
COPY turbo.json ./
COPY tsconfig.json ./
COPY packages/shared packages/shared
COPY apps/backend apps/backend

RUN npm ci --workspace=@uritech/shared --workspace=@uritech/backend --include-workspace-root \
  && npm run build --workspace=@uritech/shared \
  && npm run build --workspace=@uritech/backend \
  && npm prune --omit=dev --workspace=@uritech/shared --workspace=@uritech/backend --include-workspace-root

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/apps/backend/package.json ./apps/backend/package.json
COPY --from=builder /app/package.json ./package.json

EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/backend/dist/main.js"]
