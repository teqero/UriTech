{
  "name": "uritech",
  "version": "1.0.0",
  "private": true,
  "description": "UriTech - Super App completo inspirado no Gojek",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build --workspace=@uritech/shared && turbo run dev --filter=!@uritech/shared",
    "start:all": "powershell -ExecutionPolicy Bypass -File ./start-all.ps1",
    "start:all:kill": "powershell -ExecutionPolicy Bypass -File ./start-all.ps1 -KillPorts",
    "deploy:mobile-web": "npx vercel link --project web-user --yes && npx vercel deploy --prod --yes --local-config apps/mobile-user/vercel.json",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:backend": "turbo run dev --filter=@uritech/backend",
    "dev:web-admin": "turbo run dev --filter=@uritech/web-admin",
    "dev:web-user": "turbo run dev --filter=@uritech/web-user",
    "dev:mobile-user": "turbo run dev --filter=@uritech/mobile-user",
    "dev:mobile-driver": "turbo run dev --filter=@uritech/mobile-driver",
    "dev:mobile-vendor": "turbo run dev --filter=@uritech/mobile-vendor",
    "docker:prod": "docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d --build",
    "docker:prod:down": "docker compose -f deploy/docker-compose.prod.yml down",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "@uritech/web-user": {
      "next": "14.2.28",
      "react": "18.3.1",
      "react-dom": "18.3.1"
    },
    "@uritech/web-admin": {
      "next": "14.2.28",
      "react": "18.3.1",
      "react-dom": "18.3.1"
    },
    "@uritech/mobile-user": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "react-native": "0.81.5",
      "@react-native-async-storage/async-storage": "2.2.0"
    },
    "@uritech/mobile-driver": {
      "react": "19.1.0",
      "react-native": "0.81.5"
    },
    "@uritech/mobile-vendor": {
      "react": "19.1.0",
      "react-native": "0.81.5"
    },
    "react-native": "0.81.5"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "socket.io-client": "^4.8.3"
  }
}
